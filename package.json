{
  "name": "reporeel",
  "version": "0.1.0",
  "description": "Turn any repo into a narrated video that explains it: live demo, architecture, real code and numbers. One storyboard file, free local voice.",
  "type": "module",
  "bin": {
    "reporeel": "bin/reporeel.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "mermaid": "^12.3.0",
    "playwright": "^1.63.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "readme",
    "demo video",
    "documentation",
    "developer tools",
    "playwright",
    "text-to-speech",
    "github",
    "claude code",
    "agent skill",
    "open source"
  ],
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshDubey23/reporeel.git"
  },
  "homepage": "https://github.com/HarshDubey23/reporeel#readme",
  "author": "Harsh Dubey"
}
