{
  "name": "@theharshdubey/reporeel",
  "version": "0.3.0",
  "description": "Understand an unfamiliar codebase and trust what you are told: what a pull request can break, where to start reading, an MCP server for coding agents, and narrated films. Every claim points at a line.",
  "type": "module",
  "bin": {
    "reporeel": "bin/reporeel.js",
    "repotale": "bin/reporeel.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/doctor.test.ts test/readme.test.ts test/schema.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "mermaid": "^12.3.0",
    "playwright": "^1.63.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "code review",
    "pull request",
    "impact analysis",
    "codebase onboarding",
    "architecture",
    "import graph",
    "mcp",
    "mcp server",
    "claude code",
    "developer tools",
    "static analysis",
    "github actions"
  ],
  "files": [
    "bin",
    "dist",
    "schema",
    "skills",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!examples/*/docs",
    "!examples/*/reporeel.json",
    "!examples/*/package-lock.json",
    "web/analyze.js",
    "web/insight.js",
    "web/story.js",
    "web/filmarch.js",
    "web/arch.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshDubey23/RepoTale.git"
  },
  "homepage": "https://github.com/HarshDubey23/RepoTale#readme",
  "author": "Harsh Dubey",
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/reporeel.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
