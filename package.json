{
  "name": "@theharshdubey/reporeel",
  "version": "0.2.0",
  "description": "Turn any repo into a narrated video that explains it: live demo, architecture, real code and numbers. One storyboard file, free local voice.",
  "type": "module",
  "bin": {
    "reporeel": "bin/reporeel.js",
    "repotale": "bin/reporeel.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/doctor.test.ts test/readme.test.ts test/schema.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "mermaid": "^12.3.0",
    "playwright": "^1.63.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "readme",
    "demo video",
    "documentation",
    "developer tools",
    "playwright",
    "text-to-speech",
    "github",
    "claude code",
    "agent skill",
    "open source"
  ],
  "files": [
    "bin",
    "dist",
    "schema",
    "skills",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!examples/*/docs",
    "!examples/*/reporeel.json",
    "!examples/*/package-lock.json",
    "web/analyze.js",
    "web/insight.js",
    "web/story.js",
    "web/filmarch.js",
    "web/arch.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshDubey23/RepoTale.git"
  },
  "homepage": "https://github.com/HarshDubey23/RepoTale#readme",
  "author": "Harsh Dubey",
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/reporeel.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
